# Keep these OUT of the image build (like .gitignore, but for `docker build`).
# Most important: .env must NEVER be baked into an image — secrets are injected at
# RUN time via `docker run -e ...` instead.

# .venv/ — the image builds its OWN clean Linux deps via pip; a Windows venv is useless here
.venv/
__pycache__/
*.pyc
.pytest_cache/
# .env — secrets; injected at runtime, never copied into the image
.env
# db.sqlite3 — local dev data, not part of the app
db.sqlite3
# staticfiles/ — generated build output; collectstatic re-creates it in the container
staticfiles/
.git/
