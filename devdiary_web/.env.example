# Template for .env — committed so others know which variables exist.
# Copy this file to .env and fill in real values (never commit the real .env).
# Generate a SECRET_KEY with:
#   py -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=
# Database (chapter 35). Leave BLANK in dev to use the local SQLite default.
# In production set a Postgres URL: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=
# Origins allowed to POST forms over HTTPS (chapter 39). MUST include the scheme.
# Blank in dev; in production: https://devdiary.example.com (comma-separated for several)
CSRF_TRUSTED_ORIGINS=
# Postgres image init (chapter 38/39) — read by the db service in compose.prod.yaml.
POSTGRES_DB=devdiary
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
